# Copy to .env on the VPS, fill in, then: chmod 600 .env
# Generate each secret with:  openssl rand -hex 32

# Auth (§6). Set at least one, or the server refuses to start.
#   MCP_API_KEY     — option A, sent as the x-api-key request header
#   MCP_SECRET_PATH — option B, an unguessable path segment in the connector URL
# Setting both means a request must satisfy both.
MCP_API_KEY=
MCP_SECRET_PATH=

# Local-dev escape hatch. Never set this on a publicly reachable host.
# ALLOW_UNAUTHENTICATED=1

# Phase 2 (§5.3): base64 of the service account JSON key.
#   base64 -w0 sheets-mcp-key.json
GOOGLE_SERVICE_ACCOUNT_KEY=

# The spreadsheet ids profiles.yaml refers to as ${...} (§7.2). These are the
# only part of the registry that differs per deployment, so they are the only
# part that lives out here. Everything else — layouts, columns, descriptions —
# stays in the file, in git, in one copy.
TRAINING_SPREADSHEET_ID=
STUDY_SPREADSHEET_ID=

# Escape hatches, both rarely wanted:
#   PROFILES_PATH  — read the registry from another file
#   PROFILES_YAML  — supply the whole registry inline, ignoring the file
# PROFILES_YAML replaces the structure too, so the file and the deployment then
# hold separate copies of it and can drift. Prefer the placeholders above.
# PROFILES_PATH=
# PROFILES_YAML=

TZ=Europe/Prague
LOG_LEVEL=info
PORT=8787
PYTHONUNBUFFERED=1
